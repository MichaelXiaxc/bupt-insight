# Example reverse proxy for BUPT Insight. Copy to /etc/nginx/conf.d/ and edit.
#
# The application has no user system of its own: keep it on a private network
# (Tailscale/WireGuard) or add auth_basic / oauth2-proxy in front.

limit_req_zone $binary_remote_addr zone=bupt_api:10m rate=60r/m;

server {
    listen 443 ssl http2;
    server_name insight.example.com;

    ssl_certificate     /etc/letsencrypt/live/insight.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/insight.example.com/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 16k;          # application limit is 8k

    # auth_basic "BUPT Insight";
    # auth_basic_user_file /etc/nginx/.htpasswd;

    location /static/ {
        alias /opt/bupt-insight/app/web/static/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    location /api/ {
        limit_req zone=bupt_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

server {
    listen 80;
    server_name insight.example.com;
    return 301 https://$host$request_uri;
}
